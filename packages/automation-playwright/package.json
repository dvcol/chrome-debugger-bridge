{
  "name": "@dvcol/cdb-automation-playwright",
  "type": "module",
  "version": "0.0.0",
  "description": "Experimental Playwright automation provider for CDB embedding brokers.",
  "author": "dvcol",
  "license": "MIT",
  "homepage": "https://github.com/dvcol/chrome-debugger-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvcol/chrome-debugger-bridge.git",
    "directory": "packages/automation-playwright"
  },
  "bugs": {
    "url": "https://github.com/dvcol/chrome-debugger-bridge/issues"
  },
  "keywords": [
    "chrome",
    "chrome-debugger",
    "cdp",
    "browser-automation",
    "mcp",
    "agent"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "check:package": "publint",
    "pack": "pnpm pack --out artifacts/package.tgz",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@dvcol/cdb": "workspace:^",
    "playwright-core": "catalog:automation"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsdown": "catalog:build",
    "vitest": "catalog:testing"
  }
}
