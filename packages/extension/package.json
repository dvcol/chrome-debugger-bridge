{
  "name": "@dvcol/cdb-extension",
  "type": "module",
  "version": "0.0.0",
  "description": "CDB (Chrome Debugger Bridge) Manifest V3 debugger agent primitives.",
  "author": "dvcol",
  "license": "MIT",
  "homepage": "https://github.com/dvcol/chrome-debugger-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvcol/chrome-debugger-bridge.git",
    "directory": "packages/extension"
  },
  "bugs": {
    "url": "https://github.com/dvcol/chrome-debugger-bridge/issues"
  },
  "keywords": [
    "chrome",
    "chrome-debugger",
    "cdp",
    "browser-automation",
    "mcp",
    "agent"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "import": "./dist/bootstrap.js"
    },
    "./presentation": {
      "types": "./dist/presentation.d.ts",
      "import": "./dist/presentation.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check:package": "publint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@dvcol/cdb": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
