{
  "name": "@dvcol/chrome-debugger-bridge-mcp",
  "type": "module",
  "version": "0.0.0",
  "description": "Model Context Protocol adapter for Chrome Debugger Bridge.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvcol/chrome-debugger-bridge.git",
    "directory": "packages/mcp"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src test tsdown.config.ts vitest.config.ts --cache",
    "pack": "pnpm pack --pack-destination artifacts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "verify:pack": "publint"
  },
  "dependencies": {
    "@dvcol/chrome-debugger-bridge": "workspace:^",
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:protocol"
  },
  "publishConfig": {
    "access": "public"
  }
}
