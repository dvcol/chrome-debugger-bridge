{
  "name": "@dvcol/cdb-mcp",
  "type": "module",
  "version": "0.0.0",
  "description": "CDB (Chrome Debugger Bridge) Model Context Protocol adapter.",
  "author": "dvcol",
  "license": "MIT",
  "homepage": "https://github.com/dvcol/chrome-debugger-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvcol/chrome-debugger-bridge.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/dvcol/chrome-debugger-bridge/issues"
  },
  "keywords": [
    "chrome",
    "chrome-debugger",
    "cdp",
    "browser-automation",
    "mcp",
    "agent"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "check:package": "publint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@dvcol/cdb": "workspace:^",
    "@modelcontextprotocol/node": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:protocol"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
