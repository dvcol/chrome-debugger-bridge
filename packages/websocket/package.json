{
  "name": "@dvcol/cdb-websocket",
  "type": "module",
  "version": "0.0.0",
  "description": "CDB (Chrome Debugger Bridge) browser and Node WebSocket adapters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvcol/chrome-debugger-bridge.git",
    "directory": "packages/websocket"
  },
  "sideEffects": false,
  "exports": {
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "import": "./dist/node.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src test tsdown.config.ts vitest.config.ts --cache",
    "pack": "pnpm pack --pack-destination artifacts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "verify:pack": "publint"
  },
  "dependencies": {
    "@dvcol/cdb": "workspace:^",
    "ws": "catalog:transport"
  },
  "devDependencies": {
    "@types/ws": "catalog:types"
  },
  "publishConfig": {
    "access": "public"
  }
}
