{
  "name": "@dvcol/cdb-websocket",
  "type": "module",
  "version": "0.0.0",
  "description": "CDB (Chrome Debugger Bridge) browser and Node WebSocket adapters.",
  "author": "dvcol",
  "license": "MIT",
  "homepage": "https://github.com/dvcol/chrome-debugger-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvcol/chrome-debugger-bridge.git",
    "directory": "packages/websocket"
  },
  "bugs": {
    "url": "https://github.com/dvcol/chrome-debugger-bridge/issues"
  },
  "keywords": [
    "chrome",
    "chrome-debugger",
    "cdp",
    "browser-automation",
    "mcp",
    "agent"
  ],
  "sideEffects": false,
  "exports": {
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "import": "./dist/node.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check:package": "publint",
    "pack": "pnpm pack --out artifacts/package.tgz",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@dvcol/cdb": "workspace:^",
    "ws": "catalog:transport"
  },
  "devDependencies": {
    "@types/ws": "catalog:types",
    "tsdown": "catalog:build",
    "vitest": "catalog:testing"
  },
  "publishConfig": {
    "access": "public"
  }
}
