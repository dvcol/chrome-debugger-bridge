{
  "name": "@dvcol/cdb",
  "type": "module",
  "version": "0.0.0",
  "description": "CDB (Chrome Debugger Bridge) runtime-neutral broker, protocol, and client primitives.",
  "author": "dvcol",
  "license": "MIT",
  "homepage": "https://github.com/dvcol/chrome-debugger-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvcol/chrome-debugger-bridge.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/dvcol/chrome-debugger-bridge/issues"
  },
  "keywords": [
    "chrome",
    "chrome-debugger",
    "cdp",
    "browser-automation",
    "mcp",
    "agent"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    },
    "./authority": {
      "types": "./dist/authority.d.ts",
      "import": "./dist/authority.js"
    },
    "./broker": {
      "types": "./dist/broker.d.ts",
      "import": "./dist/broker.js"
    },
    "./automation": {
      "types": "./dist/automation.d.ts",
      "import": "./dist/automation.js"
    },
    "./cdp-catalogue": {
      "types": "./dist/cdp-catalogue.d.ts",
      "import": "./dist/cdp-catalogue.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./embedded": {
      "types": "./dist/embedded.d.ts",
      "import": "./dist/embedded.js"
    },
    "./grant-request": {
      "types": "./dist/grant-request.d.ts",
      "import": "./dist/grant-request.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./protocol.schema.json": "./dist/protocol.schema.json",
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./timing": {
      "types": "./dist/timing.d.ts",
      "import": "./dist/timing.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/generate-protocol-json-schema.ts",
    "check:package": "publint",
    "pack": "pnpm pack --out artifacts/package.tgz",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:protocol",
    "zod": "catalog:protocol"
  },
  "devDependencies": {
    "ajv": "catalog:testing",
    "ajv-formats": "catalog:testing"
  },
  "publishConfig": {
    "access": "public"
  }
}
