{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "chrome"],
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "eslint.config.ts",
    "examples/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "packages/*/src/**/*.d.ts",
    "packages/*/test/**/*.ts",
    "packages/*/tsdown.config.ts",
    "packages/*/vitest.config.ts",
    "scripts/**/*.ts",
    "tests/browser/**/*.ts",
    "tests/e2e/**/*.ts",
    "tests/fixtures/**/*.ts",
    "vitest.config.ts"
  ]
}
